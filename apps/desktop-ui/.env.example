TARGET_PROVIDER=deepseek
TARGET_BASE_URL=https://api.deepseek.com
TARGET_API_KEY=your_deepseek_api_key
TARGET_CHAT_MODEL=deepseek-chat
TARGET_REASONER_MODEL=deepseek-reasoner
TARGET_TIMEOUT_MS=120000
HOST=127.0.0.1
PORT=4317
# Optional local UI token. If set, require clients to send X-Agent-UI-Token.
AGENT_UI_TOKEN=
TOOL_RESULT_MAX_CHARS=6000
EVENT_PAYLOAD_MAX_CHARS=20000
DEEPSEEK_AUTO_REASONER=true
